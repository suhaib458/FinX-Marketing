NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0
DATABASE_URL=mysql://finx_app:change-me@127.0.0.1:3306/finx_dev
SHADOW_DATABASE_URL=mysql://finx_app:change-me@127.0.0.1:3306/finx_shadow
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local development can use a credentials file:
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json

# Vercel/serverless production should use the full Firebase service-account JSON
# as one protected server-side environment variable. Never expose it through VITE_.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com","client_id":"..."}

# Vercel production/preview domains are added automatically from
# VERCEL_PROJECT_PRODUCTION_URL and VERCEL_URL. Keep local origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_DEV_AUTH=false
LOG_LEVEL=info
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JSON_BODY_LIMIT=100kb
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
STORAGE_MODE=auto
MAX_UPLOAD_SIZE_MB=25

# AI generation through xKiro (server-side only; never expose this key through VITE_ variables)
XKIRO_API_KEY=sk-xt-your-xkiro-key
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL=google/gemini-3.7-flash
XKIRO_FALLBACK_MODEL=qwen/qwen3.8-max:free
AI_REASONING_EFFORT=none
AI_REQUEST_TIMEOUT_MS=75000
