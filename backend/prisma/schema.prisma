generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AssetType {
  LOGO
  PRODUCT_IMAGE
  GENERATED_IMAGE
  ANALYTICS_SCREENSHOT
}

enum AssetStatus {
  PENDING
  READY
  FAILED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum CreditTransactionType {
  INITIAL_GRANT
  RESERVATION
  SETTLEMENT
  REFUND
  ADJUSTMENT
}

enum GenerationTool {
  SOCIAL_POST
  AD_DESIGN
  CONTENT_IDEAS
  CAMPAIGN
}

enum GenerationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  firebaseUid         String?            @unique @db.VarChar(191)
  email               String             @unique @db.VarChar(320)
  emailVerified       Boolean            @default(false)
  name                String             @db.VarChar(160)
  photoUrl            String?            @db.VarChar(2048)
  lastLoginAt         DateTime?
  role                UserRole           @default(USER)
  status              UserStatus         @default(ACTIVE)
  planCode            String             @default("free") @db.VarChar(50)
  onboardingCompleted Boolean            @default(false)
  locale              String             @default("ar") @db.VarChar(10)
  timezone            String             @default("Asia/Amman") @db.VarChar(64)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  brands              Brand[]
  assets              Asset[]
  wallet              CreditWallet?
  creditLedger        CreditLedger[]
  generationJobs      GenerationJob[]
  generatedContents   GeneratedContent[]

  @@index([status, deletedAt])
}

model Brand {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  userId              String             @db.VarChar(36)
  businessName        String             @db.VarChar(160)
  businessDescription String?            @db.Text
  category            String?            @db.VarChar(120)
  targetAudience      String?            @db.Text
  productService      String?            @db.VarChar(300)
  productDescription  String?            @db.Text
  price               Decimal?           @db.Decimal(12, 3)
  currency            String             @default("JOD") @db.Char(3)
  website             String?            @db.VarChar(2048)
  username            String?            @db.VarChar(191)
  primaryColor        String?            @db.Char(7)
  secondaryColor      String?            @db.Char(7)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  assets              Asset[]
  generationJobs      GenerationJob[]
  contents            GeneratedContent[]

  @@index([userId, deletedAt, createdAt])
}

model Asset {
  id         String      @id @default(uuid()) @db.VarChar(36)
  userId     String      @db.VarChar(36)
  brandId    String?     @db.VarChar(36)
  type       AssetType
  status     AssetStatus @default(PENDING)
  storageKey String      @unique @db.VarChar(512)
  publicUrl  String?     @db.VarChar(2048)
  mimeType   String      @db.VarChar(128)
  byteSize   BigInt
  width      Int?
  height     Int?
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand      Brand?      @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([brandId, deletedAt])
}

model CreditWallet {
  id        String         @id @default(uuid()) @db.VarChar(36)
  userId    String         @unique @db.VarChar(36)
  balance   Int            @default(0)
  version   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger    CreditLedger[]
}

model CreditLedger {
  id             String                @id @default(uuid()) @db.VarChar(36)
  walletId       String                @db.VarChar(36)
  userId         String                @db.VarChar(36)
  direction      LedgerDirection
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int
  idempotencyKey String                @db.VarChar(191)
  description    String?               @db.VarChar(500)
  referenceType  String?               @db.VarChar(100)
  referenceId    String?               @db.VarChar(191)
  metadata       Json?
  createdAt      DateTime              @default(now())
  wallet         CreditWallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([walletId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
}

model GenerationJob {
  id                String              @id @default(uuid()) @db.VarChar(36)
  userId            String              @db.VarChar(36)
  brandId           String?             @db.VarChar(36)
  tool              GenerationTool
  status            GenerationJobStatus @default(QUEUED)
  input             Json
  modelIdentifier   String?             @db.VarChar(191)
  providerRequestId String?             @db.VarChar(191)
  creditCost        Int
  idempotencyKey    String              @db.VarChar(191)
  errorCode         String?             @db.VarChar(100)
  errorMessage      String?             @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand             Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  generatedContents GeneratedContent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([brandId, createdAt])
}

model GeneratedContent {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  userId              String             @db.VarChar(36)
  brandId             String?            @db.VarChar(36)
  generationJobId     String             @db.VarChar(36)
  originalContentId   String?            @db.VarChar(36)
  tool                GenerationTool
  language            String             @db.VarChar(10)
  platform            String?            @db.VarChar(80)
  title               String?            @db.VarChar(300)
  content             Json
  submittedParameters Json
  savedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  brand               Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  generationJob       GenerationJob      @relation(fields: [generationJobId], references: [id], onDelete: Restrict)
  originalContent     GeneratedContent?  @relation("ContentVariations", fields: [originalContentId], references: [id], onDelete: SetNull)
  variations          GeneratedContent[] @relation("ContentVariations")

  @@index([userId, deletedAt, createdAt])
  @@index([userId, savedAt, createdAt])
  @@index([userId, tool, platform, createdAt])
  @@index([brandId, createdAt])
  @@index([originalContentId])
}
