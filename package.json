{
  "name": "finx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.js eslint.config.js",
    "test": "vitest src",
    "test:run": "vitest run src",
    "backend:install": "npm --prefix backend install",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend start",
    "lint:backend": "npm --prefix backend run lint",
    "test:backend": "npm --prefix backend test",
    "test:backend:run": "npm --prefix backend run test:run",
    "backend:openapi": "npm --prefix backend run openapi:validate",
    "test:mysql": "npm --prefix backend run test:mysql",
    "smoke:backend": "npm --prefix backend run smoke:api",
    "db:validate": "npm --prefix backend run db:validate",
    "db:generate": "npm --prefix backend run db:generate",
    "db:check": "npm --prefix backend run db:check",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:status": "npm --prefix backend run db:status",
    "db:seed": "npm --prefix backend run db:seed",
    "db:verify-seed": "npm --prefix backend run db:verify-seed",
    "verify:source": "npm run lint && npm run test:run && npm run build && npm run db:validate && npm run db:generate && npm run lint:backend && npm run test:backend:run && npm run backend:openapi",
    "verify:database": "npm run db:check && npm run db:status && npm run test:mysql && npm run smoke:backend && npm run db:verify-seed",
    "verify": "npm run verify:source && npm run verify:database",
    "ai:check": "npm --prefix backend run ai:check",
    "ai:models": "npm --prefix backend run ai:models",
    "storage:check": "npm --prefix backend run storage:check",
    "db:deploy": "npm --prefix backend run db:deploy"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
